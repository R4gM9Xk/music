<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 唤醒锁：播放器 setWakeMode(WAKE_MODE_LOCAL) 息屏连播曲间不断流（normal 权限，无需运行时申请） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 所有文件访问：读取任意公共目录的同名 .lrc 歌词（Download/QQ 等），特殊权限经系统页授权 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- 桌面歌词悬浮窗（P0-8）：TYPE_APPLICATION_OVERLAY 的前置权限（special app access，
         用户在「显示在其他应用上层」页手动授予，不是运行时弹窗）。
         代码侧必须先判 Settings.canDrawOverlays() 再 addView——部分 ROM 即便授权过也会
         动态撤销，所有 WindowManager 操作另有 runCatching 兜底（见 DesktopLyricsController）。
         未授权时歌词功能静默不可用（不崩溃、不弹系统弹窗），由设置入口引导授权 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- E2 包可见性（Android 11+ / targetSdk 30+）：AutoStartGuide 用 resolveActivity 探测
         厂商自启动/电池页，未声明 <queries> 时这些包全部不可见 → 只能落到应用详情页兜底。
         按候选组件逐包精确声明（与 AutoStartGuide.CANDIDATES 一一对应，比 intent-filter
         queries 精确）；Settings.ACTION_* 系统 action 自身可见，无需在此声明 -->
    <queries>
        <!-- ColorOS 自启动管理（多版本入口同包） -->
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oplus.safecenter" />
        <!-- 电池 / 耗电管理 -->
        <package android:name="com.coloros.oppoguardelf" />
        <package android:name="com.oplus.battery" />
        <!-- 通用兜底候选：应用详情页（InstalledAppDetails 组件型候选也走 resolveActivity） -->
        <package android:name="com.android.settings" />
    </queries>

    <!-- P3-⑥：attributionTags 必须**预先在 manifest 声明**，否则 Android 12+ 的
         AppOps 归因链拿不到归属，系统侧在 AppOps 探测处刷 E 级日志
         （「attributionTag ... not declared」）。归因 tag 是 API 31+ 的机制：
         应用若以带 tag 的 Context 访问受 AppOps 管控的能力（这里主要落在
         media3 的媒体会话/通知链路 —— 通知栏媒体控件、蓝牙媒体按钮都要过
         AppOps 的媒体控制校验），该 tag 必须先出现在 ApplicationInfo.attributionTags 里。
         只声明不改行为：不动任何权限、不改变功能，仅让系统有确定归属可写。
         单个 tag 足够——本应用所有音频播放/媒体会话同属一个业务域。 -->
    <application
        android:label="音乐"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.ColorOSMusic"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:attributionTags="media_playback">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          ════════════════════════════════════════════════════════════════════
          音乐应用的「身份声明」（游戏助手 / 车机 / 手表 / 系统音乐入口的识别依据）
          ════════════════════════════════════════════════════════════════════
          CATEGORY_APP_MUSIC 是系统识别「这是一个音乐 App」的**唯一标准方式**，
          也是各厂商游戏助手（ColorOS 游戏助手 / MIUI 游戏加速 / vivo 游戏魔盒 /
          华为应用助手）在游戏内列出「音乐卡片」时的候选来源之一。

          为什么之前没写它（诚实记录）：旧实现只在 sessionActivity 的 Intent 上
          加了 CATEGORY_APP_MUSIC（见 MusicPlaybackService），那是**运行时 Intent 的
          category**，与**Manifest 里的组件 category 声明**是两件事——
          PackageManager 查询 "有哪些音乐应用" 读的是后者，前者只影响那一次跳转的解析。
          所以系统侧一直不知道本应用属于音乐类，游戏助手的音乐列表里也就可能不出现。

          APP_MUSIC 必须**单独一个 intent-filter**：它不能与 LAUNCHER 合并，
          否则 PackageManager 会把它当成「启动器入口的附加分类」而非独立的音乐应用声明。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 音乐应用身份：游戏助手/车机/手表据此把本应用列为音乐来源 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.MusicPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
          媒体按钮接收器（游戏外设 / 蓝牙手柄 / 耳机线控 / 游戏助手的媒体键）

          **为什么必须显式声明**：media3 的 MediaSessionService 不会自动注册
          MEDIA_BUTTON receiver。没有它时，系统把媒体键事件发到 AudioManager 后，
          若本应用会话不是「最近活跃」，事件会落到 null 而丢失——
          表现就是「戴着蓝牙耳机打游戏，耳机上的播放/暂停键没反应」。

          为什么用 media3 官方的 MediaButtonReceiver：它内部把 KeyEvent 转成
          Controller 的 transport 动作再喂给**当前活跃会话**，不需要我们自己处理
          ACTION_MEDIA_BUTTON 的 ACTION_DOWN/UP 配对与重复事件去抖
          （手写那段极易在长按时连发多次 next）。
        -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
          ════════════════════════════════════════════════════════════════════
          桌面小部件（P0-6）
          ════════════════════════════════════════════════════════════════════
          两个尺寸 = 两个独立 receiver（各自带自己的 appwidget-provider meta-data），
          这样系统小部件选择器里会出现两张卡片，用户能分别放置。

          exported="false"：AppWidgetProvider 由系统的 AppWidgetService 唤起。
          **这里必须是 false，系统仍能正常唤起它** —— 因为桌面/系统服务是以
          「同 uid 的广播」之外的路径（AppWidgetManager 内部的显式组件调用）触达，
          且 Glance 官方模板同样用 false。写成 true 只是把攻击面放大（任何应用都能
          往你的 APPWIDGET_UPDATE 广播里塞 ID），没有好处。

          meta-data 的 android:resource 指向 res/xml/music_widget_4x1.xml（appwidget-provider）。

          intent-filter 的 action 声明（本轮修正了这里原先的错误结论）：
          - **APPWIDGET_UPDATE**：放置/周期刷新，必须声明。
          - **APPWIDGET_OPTIONS_CHANGED**：尺寸变化，**必须声明**。旧注释写「由回调分发
            自动送达、不需要单独声明」，实际系统是按 action 匹配 receiver 才唤起 onReceive，
            再由 AppWidgetProvider 分派 —— 不声明就收不到，表现为「拖拽改尺寸后不重绘」。
          - **APPWIDGET_DELETED / APPWIDGET_DISABLED**：这两个确实由系统按组件直接投递
            （不经 action 匹配），保持不声明。
          ════════════════════════════════════════════════════════════════════
        -->
        <receiver
            android:name=".widget.MusicWidgetWideProvider"
            android:exported="false"
            android:label="@string/widget_label_wide">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- APPWIDGET_OPTIONS_CHANGED 必须显式声明（本轮修复）。
                     旧注释断言「由 AppWidgetProvider 的回调分发自动送达，不需要单独声明」，
                     这个断言是错的：系统是**按 action 匹配 receiver** 才唤起 onReceive，
                     再由 AppWidgetProvider.onReceive 分派到 onAppWidgetOptionsChanged。
                     不声明 ⇒ 该回调不会到达 ⇒ 用户拖拽改变小部件尺寸后不会重绘，
                     按 OPTION_APPWIDGET_MIN_WIDTH 选横条/封面版的逻辑要等到下一次播放事件
                     才生效（本模块是事件驱动 + updatePeriodMillis=0），
                     观感即「拖窄了还是老样子」。
                     APPWIDGET_DELETED / APPWIDGET_DISABLED 则确实由系统按组件直接投递
                     （它们不经过 APPWIDGET_UPDATE 的 action 匹配），保持不声明。 -->
                <action android:name="android.appwidget.action.APPWIDGET_OPTIONS_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_widget_4x1" />
        </receiver>

        <receiver
            android:name=".widget.MusicWidgetSquareProvider"
            android:exported="false"
            android:label="@string/widget_label_square">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- 同 MusicWidgetWideProvider：OPTIONS_CHANGED 必须显式声明 -->
                <action android:name="android.appwidget.action.APPWIDGET_OPTIONS_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_widget_4x2" />
        </receiver>

        <!--
          小部件控制动作的转发入口（上一首 / 播放暂停 / 下一首）。

          exported="false" 是**安全要求**而不只是习惯：
          小部件的 PendingIntent 是显式组件广播（setClass 到本 receiver），
          exported=false 时系统外没有任何应用能伪造「下一首」「暂停」这类命令。
          若写成 true，任何应用都能往这三个 action 上灌广播来操控用户的播放器。

          冷知识：PendingIntent 由系统代发，不受 exported 限制 —— 即使这里是 false，
          小部件照样能正常触发（这是 Android 有意设计，PendingIntent 的授权在
          创建时就固化了）。所以 false 完全不影响功能，只砍掉攻击面。
        -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />
    </application>

</manifest>
