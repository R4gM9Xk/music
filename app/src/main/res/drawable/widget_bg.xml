<?xml version="1.0" encoding="utf-8"?>
<!--
  小部件整体背景：深色圆角卡片。

  **必须是单独的 drawable，不能直接给 @drawable 里塞 background 属性**：
  Android 12+ 的系统小部件有「圆角跟随系统」的行为，如果背景是不透明的直角矩形，
  系统会把它裁成圆角，但部分 ROM（含 ColorOS）实现不一致 —— 要么不裁（露出直角），
  要么裁了但我们的圆角半径与之不匹配（出现「双圆角」）。这里自己画 24dp 圆角，
  与主流 ROM 的小部件默认圆角半径接近，观感最稳。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 深色玻璃底：与应用的液态玻璃流一致，但不做真模糊（小部件里做不了实时模糊） -->
    <solid android:color="#F21C1C22" />
    <corners android:radius="24dp" />
</shape>
