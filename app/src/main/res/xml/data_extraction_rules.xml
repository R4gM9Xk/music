<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的云备份 / 设备迁移规则。

  与应用私有目录一并排除：播放现场（queue_state.json）、曲库缓存（library_cache.json）、
  设置快照（DataStore）、下载好的更新包（update/app-update.apk）都是**设备本地状态**——
  跨设备迁移没有意义，而更新包体积大且未经验签，更不该跟着备份走。
  allowBackup 已在 <application> 上显式置 false，本规则作为 Android 12+ 的补充口径。

  P3-61：过去只排除了 file 域——但快照在 DataStore（sharedpref 域）、
  可能存在的数据库/外部域文件同样不该跟着备份走，逐域补齐。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
